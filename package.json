{
  "name": "team-bot",
  "version": "1.0.0",
  "description": "AI-powered WhatsApp Tech Team Assistant & Teammate Bot",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch --watch-path=src src/index.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "@whiskeysockets/baileys": "^6.7.16",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.5.0",
    "node-cron": "^3.0.3",
    "pino": "^9.7.0",
    "qrcode-terminal": "^0.12.0"
  },
  "overrides": {
    "libsignal": "6.0.0"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "better-sqlite3@11.10.0": true,
    "@whiskeysockets/baileys": true,
    "@whiskeysockets/baileys@6.7.24": true,
    "@google/genai": true,
    "@google/genai@1.52.0": true,
    "protobufjs": true,
    "protobufjs@7.6.6": true
