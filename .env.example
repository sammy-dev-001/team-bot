# ──────────────────────────────────────────────
#  AI-Powered WhatsApp Team Bot — Environment
# ──────────────────────────────────────────────

# Google Gemini API Key (get from https://aistudio.google.com)
GEMINI_API_KEY=[GCP_API_KEY]

# Gemini Model identifier (defaults to gemini-3.6-flash)
# Supported options: gemini-3.6-flash, gemini-3.8-flash, gemini-2.5-flash
GEMINI_MODEL=gemini-3.6-flash

# The WhatsApp group JID(s) the bot should operate in.
# Accepts a single group JID or a comma-separated list of group JIDs.
# Leave BLANK on first run — the bot will print all incoming group JIDs to console.
# Copy the correct one(s), paste here, then restart.
ALLOWED_GROUP_JID=

# Admin / Authorized user JIDs allowed to message the bot directly in 1-on-1 DMs.
# Accepts comma-separated phone numbers or full JIDs (e.g. 2348012345678,2348098765432@s.whatsapp.net).
# If left blank, members registered in the team directory can DM the bot.
ADMIN_JIDS=

# Display name the bot uses to refer to itself in messages
BOT_NAME=TeamBot

# IANA timezone for cron jobs and timestamps
TIMEZONE=Africa/Lagos

# Raw message history retention in days before weekly cleanup (minimum 90 days).
# Team directory, tasks, deadlines, project notes, and daily summaries are kept forever.
MESSAGE_RETENTION_DAYS=90
